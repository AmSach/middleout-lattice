// lattice_gui.rc — Windows resource file for Lattice GUI
// Embeds the application icon and registers the .lattice file type icon.

#include <windows.h>

// Application icon (main GUI icon)
IDI_ICON1 ICON "../assets/lattice.ico"

// Version info
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Middleout-Lattice Project"
            VALUE "FileDescription",  "Lattice Compression Engine"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "lattice_gui"
            VALUE "LegalCopyright",   "Copyright 2024-2026 Middleout-Lattice Project"
            VALUE "OriginalFilename", "lattice_gui.exe"
            VALUE "ProductName",      "Middleout-Lattice"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
